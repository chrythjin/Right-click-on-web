{
  "manifest_version": 3,
  "name": "Right-click on Web",
  "version": "0.11.0",
  "description": "Restores common right-click, text selection, copy, and drag interactions, and extracts text via local OCR on restrictive websites.",
  "icons": {
    "128": "icons/icon128.png",
    "512": "icons/icon512.png"
  },
  "action": {
    "default_title": "Right-click on Web",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "options.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["shared.js", "ocr-session-utils.js", "ocr-history.js", "toolbar-action-utils.js", "image-context.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["image-context.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js", "video-controller.js"],
      "css": ["video-controller.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["keyboard-utils.js", "crop-overlay.js"],
      "css": ["crop-overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "trigger-ocr": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "화면 영역 텍스트 추출 (OCR 캡처)"
    },
    "rerun-ocr": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Command+Shift+R"
      },
      "description": "마지막 OCR 영역 다시 인식"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/*", "langs/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "minimum_chrome_version": "121",
  "permissions": ["storage", "activeTab", "contextMenus", "sidePanel", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "right-click-on-web@chryth.github.io",
      "strict_min_version": "128.0"
    }
  }
}
